# ============================================================
# BizFlow environment configuration — TESTNET ONLY
# Copy to .env and fill in values. NEVER commit .env.
# ============================================================

# ---------- Application ----------
ENVIRONMENT=development
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend calls the backend through the Next.js /api/v1 rewrite by default.
# Set BACKEND_ORIGIN only when running the frontend separately from the backend.
NEXT_PUBLIC_API_BASE_URL=/api/v1
BACKEND_ORIGIN=http://localhost:8000

# ---------- Security ----------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---------- Database (PostgreSQL) ----------
POSTGRES_DB=bizflow
POSTGRES_USER=bizflow
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://bizflow:replace-with-a-strong-password@localhost:5432/bizflow

# Local test fallback (a REAL SQLite database, used only when USE_SQLITE=true)
USE_SQLITE=false
SQLITE_URL=sqlite:///./bizflow_test.db

# ---------- Stellar (TESTNET ONLY — never change to mainnet) ----------
# The passphrase is the authoritative network identity; the backend refuses
# any value other than the Testnet passphrase.
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Deployed Soroban escrow contract ID. Leave empty until the contract is actually
# deployed to Testnet. NEVER invent or hardcode a fake contract ID.
STELLAR_ESCROW_CONTRACT_ID=
# A real Testnet instance deployed during this build (see docs/TESTNET_DEPLOYMENT.md):
# CBEIRUNYWZ54JOSYJD6VGJUTPAZHPMEOJIAYECWCXZVMT7FOBBO57HGK

# ---------- Security / runtime ----------
# Set to production (or staging) in any deployed environment: this forces
# Secure cookies and requires a strong JWT_SECRET.
# ENVIRONMENT=production
# Strict Origin/Referer or double-submit CSRF validation on cookie mutations.
ENFORCE_CSRF_ORIGIN_CHECK=true
# Independently read Soroban contract state after each settled escrow operation.
ENFORCE_ESCROW_STATE_VERIFICATION=true
# Reject request bodies larger than 8 MiB (attachments are capped at 5 MiB).
MAX_REQUEST_BODY_BYTES=8388608

# ---------- Rate limiting ----------
RATE_LIMIT_PER_MINUTE=120
